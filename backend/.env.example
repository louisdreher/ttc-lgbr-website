ENVIRONMENT=development

# Relative paths resolve against backend/. Use persistent storage in production.
MEDIA_DIRECTORY=output/media
MEDIA_MAX_UPLOAD_BYTES=20971520

# MyTischtennis timing is configured through /api/admin/mytt/settings.
OUTBOX_POLL_INTERVAL_SECONDS=10
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_LEASE_SECONDS=300
OUTBOX_RETRY_SECONDS=60

LOG_LEVEL=INFO
MYTT_LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIRECTORY=output/logs
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/DATABASE

JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

REFRESH_TOKEN_EXPIRE_DAYS=30

REFRESH_COOKIE_NAME=refresh_token
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
COOKIE_PATH=/api/auth

# Invitations and password reset links. Use HTTPS for the public website.
PUBLIC_FRONTEND_URL=http://localhost:4200
PASSWORD_LINK_MINUTES=60
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_STARTTLS=true
